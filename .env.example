# Copy to .env.local and fill in what you need. Real values are never committed (.env* is gitignored).

# Database. Leave empty for local development: Assertly then runs PGlite, a Postgres in .data/pglite,
# and applies migrations by itself. In production set a Neon connection string and run `npm run db:migrate`.
DATABASE_URL=

# Required in production (the app refuses to start without it). Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public address of the site, for example https://assertly.example.com. Needed in production.
BETTER_AUTH_URL=

# Optional: enables "Continue with GitHub". Create a GitHub OAuth app whose callback URL is
# <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email, for password reset and email confirmation. Without these, production still works: it just does not offer
# either, and the sign-in page has no "Forgot your password?" link. In development, with none of this set, the emails
# are printed in the terminal where `npm run dev` runs, links and all.
# Create a key at resend.com and verify the domain you send from. EMAIL_FROM must be an address on that domain, for
# example: Assertly <no-reply@assertly.example.com>. BETTER_AUTH_URL (above) is required with them: the links in the
# emails are built from it, not from the request, which an attacker could forge.
RESEND_API_KEY=
EMAIL_FROM=

